{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv sync *)",
      "Bash(uv lock *)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff *)",
      "Bash(uv run pyright *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)"
    ],
    "ask": [
      "Bash(modal run *)",
      "Bash(modal deploy *)",
      "Bash(modal sandbox *)",
      "Bash(gh pr merge *)",
      "Bash(gh release *)",
      "Bash(uv publish *)",
      "Bash(git push origin main *)",
      "Bash(git push origin HEAD:main *)"
    ],
    "deny": [
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push *--force*)",
      "Bash(git push *+*)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/lint_python.py",
            "timeout": 60,
            "statusMessage": "ruff"
          }
        ]
      }
    ]
  }
}
