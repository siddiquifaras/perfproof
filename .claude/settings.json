{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv *)",
      "Bash(uvx *)",
      "Bash(python3 *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git switch *)",
      "Bash(git checkout *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git branch *)",
      "Bash(git worktree *)",
      "Bash(git stash push *)",
      "Bash(git push *)",
      "Bash(gh pr *)",
      "Bash(gh run *)",
      "Bash(gh api *)",
      "Bash(gh search *)",
      "Bash(gh repo view *)",
      "Bash(docker *)",
      "Bash(make *)",
      "Bash(npm install *)",
      "Bash(open -a Docker)"
    ],
    "ask": [
      "Bash(modal run *)",
      "Bash(modal deploy *)",
      "Bash(modal sandbox *)",
      "Bash(modal shell *)",
      "Bash(gh release *)",
      "Bash(gh repo edit *)",
      "Bash(uv publish *)"
    ],
    "deny": [
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push *--force*)",
      "Bash(git push *+*)",
      "Bash(docker system prune*)",
      "Bash(docker volume prune*)",
      "Bash(docker image prune*)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/lint_python.py",
            "timeout": 60,
            "statusMessage": "ruff"
          }
        ]
      }
    ]
  }
}
